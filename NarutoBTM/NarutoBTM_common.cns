[Statedef 40]
type = S
movetype = I
physics = S
ctrl = 0
anim=40+10000*Var(42)
velset = 0,0

[State 40, Jump impulse]
type = VelSet
trigger1 = Time = 3
x = IfElse(command="holdfwd",3.2,IfElse(command="holdback",-3,0))
y = -9

[State 40, Air control]
type = ChangeState
trigger1 = Time >= 4
value = 50
ctrl = 1

[Statedef 45]
type = A
movetype = I
physics = A
ctrl = 0
anim=41+10000*Var(42)
[State 45, Double jump]
type = VelSet
trigger1 = Time = 0
y = -7.5

[State 45, Return to movement]
type = ChangeState
trigger1 = Time >= 2
value = 50
ctrl = 1

[Statedef 50]
type = A
movetype = I
physics = A
ctrl = 1
anim=41+10000*Var(42)
[State 50, Descent pose]
type = ChangeAnim
trigger1 = Vel Y>0 && Anim != 44+10000*Var(42)
value=(44)+10000*Var(42)

[State 50, Land]
type = ChangeState
trigger1 = Vel Y>0 && Pos Y>=0
value = 52
ctrl = 1

[Statedef 52]
type = S
movetype = I
physics = S
ctrl = 0
anim=52+10000*Var(42)
velset = 0,0

[State 52, Feet on floor]
