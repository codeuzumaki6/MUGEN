value = 0
ctrl = 1

[Statedef 120]
type = U
movetype = I
physics = U
ctrl = 0

[State 120, Preserve grounded crouch guard]
type = StateTypeSet
trigger1 = StateType=S && command="holddown"
statetype=C
physics=C

[State 120, Standing guard when down released]
type = StateTypeSet
trigger1 = StateType=C && command!="holddown"
statetype=S
physics=S

[State 120, Form-aware start pose]
type = ChangeAnim
trigger1 = Time=0
value=(120+(StateType=C)+(StateType=A)*2)+10000*Var(42)

[State 120, Enter native guard family]
type = ChangeState
trigger1 = Time>=3
value=130+(StateType=C)+(StateType=A)*2
ctrl=0

[State 120, Release early guard]
type = ChangeState
trigger1 = command!="holdback"
value=IfElse(StateType=A,50,0)
ctrl=1

