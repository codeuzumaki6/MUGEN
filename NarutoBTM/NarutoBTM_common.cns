; Jura common states, derived from project native MUGEN guard and recovery.

[Statedef 0]
type = S
movetype = I
physics = S
ctrl = 1
anim=0+10000*Var(42)
velset = 0,0

[State 0, Neutral]
type = Null
trigger1 = 1


[Statedef 10]
type = C
movetype = I
physics = C
ctrl = 1
anim=10+10000*Var(42)
velset = 0,0

[State 10, Return to movement]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

[Statedef 11]
type = C
movetype = I
physics = C
ctrl = 1
anim=11+10000*Var(42)
velset = 0,0

[State 11, Release crouch]
type = ChangeState
trigger1 = command != "holddown"
value = 0
ctrl = 1

[Statedef 12]
type = S
movetype = I
physics = S
ctrl = 1
anim=12+10000*Var(42)
velset = 0,0

[State 12, Return to movement]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

[Statedef 20]
type = S
movetype = I
physics = S
ctrl = 1

[State 20, Walk forward]
type = VelSet
trigger1 = command = "holdfwd" || AILevel>0
x = Const(velocity.walk.fwd.x)

[State 20, Walk backward]
type = VelSet
trigger1 = command = "holdback" && AILevel=0
x = Const(velocity.walk.back.x)

[State 20, Walk animation]
type = ChangeAnim
trigger1 = Anim != IfElse(Vel X<0,21,20)+10000*Var(42)
value=(IfElse(Vel X<0,21,20))+10000*Var(42)

[State 20, Return to movement]
type = ChangeState
trigger1 = AILevel=0 && command != "holdfwd" && command != "holdback"
value = 0
ctrl = 1

[Statedef 100]
type = S
movetype = I
physics = N
ctrl = 0
anim=100+10000*Var(42)
velset = 7.6,0

[State 100, Grounded dash to either side]
type = PosSet
trigger1 = 1
y = 0

[State 100, Maintain the short dash impulse]
type = VelSet
trigger1 = Time < 14
x = 7.6
y = 0

[State 100, Short dash wind]
type = PlaySnd
trigger1 = Time = 0
value = S1,30
channel = 2

[State 100, End the short dash cue]
type = StopSnd
trigger1 = Time = 8
channel = 2

[State 100, Dash motion trail]
type = AfterImage
trigger1 = Time = 0
time = 12
length = 4
timegap = 2
framegap = 2
palcontrast = 90,130,180
trans = Add

[State 100, Return to movement]
type = ChangeState
trigger1 = Time >= 14
value = 0
ctrl = 1

[Statedef 105]
type = S
movetype = I
