; Dedicated four-pose run cycle, followed by a cancellable braking pose.
; No invulnerability, teleport, sprite replacement, or scale change.
[State 100, Jump out of dash]
type = ChangeState
trigger1 = command = "holdup"
value = 40

[State 100, Stop released dash]
type = ChangeState
trigger1 = command != "holdfwd"
trigger2 = Time >= 40
value = 106
ctrl = 1

; Compatibility sink for the dash spark helper requested by Code's proven
; common movement states. Eida uses no borrowed visual effect here.
[Statedef 105]
type = A
movetype = I
physics = N
anim = -1
ctrl = 0

[State 105, End]
type = DestroySelf
trigger1 = Time = 0

