trigger1 = 1
scale = 1,1

[State -2, Stop released charge]
type = StopSnd
triggerall = IsHelper = 0
trigger1 = StateNo != 500
channel = 7

[State -2, Awakening timer]
type = VarAdd
trigger1 = Var(40) = 1
trigger1 = Var(41) > 0
trigger1 = RoundState = 2
v = 41
value = -1

[State -2, End Awakening]
type = VarSet
trigger1 = Var(40) = 1
trigger1 = Var(41) <= 0
