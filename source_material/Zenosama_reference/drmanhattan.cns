;※ドットはスト3ギルの横幅をmspaint.exeで80%に縮小するとDrマンハッタンの胴体になる
[Data]
life= 99999
power= 999999
attack= 400
defence= 300
fall.defence_up=50
liedown.time=60
airjuggle=15
sparkno=0
guard.sparkno=2
KO.echo=0
volume=225
intpersistindex=20
floatpersistindex=40
[Size]
xscale=1
yscale=1
ground.back=15
ground.front=16
air.back=22
air.front=22
height=40
attack.dist=160
proj.attack.dist=90
proj.doscale=0
head.pos=-5,-90
mid.pos=-5,-60
shadowoffset=0
draw.offset=0,0
[Velocity]
walk.fwd=4.6
walk.back=-4.3
run.fwd=4.6,0
run.back=-4.5,-3.8
jump.neu=0,-10.9
jump.back=-10.5
jump.fwd=2.55
runjump.back=-2.55,-7
runjump.fwd=4,-7
airjump.neu=0,-7
airjump.back=-2.5
airjump.fwd=2.55
[Movement]
airjump.num=4
airjump.height=10
yaccel=.58
stand.friction=.85
crouch.friction=.82
