;helper(0) 影
;helper(2) StateDef3000技
;---------------------------------------------------------------------------
;var(0) 被弾フラグ
;var(1) helper(0)が出せない
;var(10) ダッシュワープ距離
;var(50) random
;var(51) AI
;sysvar(2) ダメージ管理
[statedef -2]
[state ]
type=DisplayToClipboard
trigger1=!ishelper
text="alive:%d hpt:%d :%d"
ignorehitpause=1
[state ]
type=selfstate
trigger1=ishelper
trigger1=stateno!=5150
value=5150
ignorehitpause=1
[state ]
type=palfx
trigger1=!ishelper
time=0
ignorehitpause=1
[state ]
type=lifeset
trigger1=!ishelper
value=lifemax-sysvar(2)
ignorehitpause=1
[state ]
type=nothitby
trigger1=!ishelper
trigger1=statetype=a
time=1
value=sca
ignorehitpause=1
[state ]
type=assertspecial
trigger1=!ishelper
flag=nostandguard
flag2=nocrouchguard
flag3=noairguard
ignorehitpause=1
[state ]
type=trans
trigger1=!ishelper
trans=addalpha
alpha=256,-40+var(0)*20+abs(60-gametime%120)*2
ignorehitpause=1
[state ]
type=posset
trigger1=!ishelper
trigger1=movetype=H
x=helper(0),pos x
y=helper(0),pos y
ignorehitpause=1
[state ]
type=selfstate
triggerall=!ishelper
trigger1=movetype=H
trigger1=var(0):=9-(statetype=A*9)||1
trigger2=!time&&anim!=stateno
value=anim
ctrl=1
ignorehitpause=1

[State 0, Explod]
type = Explod
trigger1 =  time = 50
anim =   1233
pos = 10,-20
postype = p1
facing = 1
vfacing = 1
bindtime = -1
removetime = 80
scale = 1.2,1.2
supermove   =-1
pausemove = -1
sprpriority = 0
ontop = 0
shadow = 0,0,0
ownpal = 0
removeongethit = 1
