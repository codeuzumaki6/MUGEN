[State -1]
type=changestate
triggerall=command="z"
triggerall=roundstate=2&&ctrl
trigger1=var(59)!=1
trigger2=var(59)=1
trigger2=!(random%7)||life<lifemax*.4
value=4000
ignorehitpause=1
[State -1, Stand Strong Punch]
type=changestate
triggerall=command="c"
triggerall=roundstate=2&&ctrl
trigger1=var(59)!=1
trigger2=var(59)=1
trigger2=!(random%7)||life<lifemax*.4
value=210
ignorehitpause=1
triggerall = statetype = S
trigger1 = ctrl
triggerall = !var(59)
;Kamehameha Goku Deus
[State -1,Kamehameha Deus]
type = ChangeState
value = 1999
trigger1=command="x"
triggerall = var (9) =0
trigger1 = (statetype = s) && ctrl
trigger2 = stateno = 200
trigger2 = time > 18
triggerall=power>20
;Kamehameha Goku Deus2
[State -1,Kamehameha Deus2]
type = ChangeState
value = 19999
trigger1=command="y"
triggerall = var (9) =0
trigger1 = (statetype = s) && ctrl
trigger2 = stateno = 200
trigger2 = time > 18
triggerall=power>50
