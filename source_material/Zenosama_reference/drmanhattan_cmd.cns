[Statedef -1]
[state ]
type=parentvarset
triggerall=ishelper
trigger1=command="a"^^command="a2"
trigger2=command="b"^^command="b2"
trigger3=command="c"^^command="c2"
trigger4=command="x"^^command="x2"
trigger5=command="y"^^command="y2"
trigger6=command="z"^^command="z2"
trigger7=command="start"^^command="start2"
trigger8=command="holdfwd"^^command="holdfwd2"
trigger9=command="holdback"^^command="holdback2"
trigger10=command="holdup"^^command="holdup2"
trigger11=command="holddown"^^command="holddown2"
var(59)=1
ignorehitpause=1

[state ]
type=helper
trigger1=!numhelper(0)
name="0"
id=0
stateno=5150
ownpal=0
helpertype=player
ignorehitpause=1
supermovetime=9999999999
pausemovetime=9999999999
[state ]
type=helper
trigger1=!numhelper(1)
name="1"
id=1
stateno=5150
ownpal=0
helpertype=player
keyctrl=1
ignorehitpause=1
supermovetime=9999999999
pausemovetime=9999999999
[State -1]
type=varset
trigger1=!numhelper(0)
trigger2=helper(0),stateno!=5150
var(1)=1
ignorehitpause=1
[State -1]
type=varadd
triggerall=movetype=H
trigger1=alive=1
trigger2=!(random%((lifemax/life)-3))
sysvar(2)=var(0)%10
[State -1]
type=varadd
trigger1=!(random%3)
trigger1=sysvar(2)>0
sysvar(2)=-1-(random%5)
ignorehitpause=1
[State -1]
type=statetypeset
trigger1=movetype=h
movetype=I
ignorehitpause=1

[State -1]
type=changestate
trigger1=!alive
value=191
ignorehitpause=1

[State -1]
type=changestate
trigger1=RoundsExisted=0
trigger1=roundstate=0
value=190
ignorehitpause=1
[State -1]
