;---------------------------------------------------------------------------
;Nachel氏NACH04_Reimuより
;■■■■■■■■■■■■■■■■■■■■■■■■■
;	[エフェクト]霊撃エフェクト - 輪
;--------------------------------------------------
;各Animについて
;30000		高速ジャンプエフェクト
;
;各Varについて（St30100独自）
;  Var( 1)	フェードアウト
;  Var( 2)	拡大率
; FVar( 1)	拡大率増加分
;
;------------------------------
[StateDef 30100]
Type=A
MoveType=I
Physics=N
Anim=30000
SprPriority=100

[State 30100, AssertSpecial]
Type = AssertSpecial
Trigger1 = 1
Flag = NoShadow

[State 30100, Helper]
Type = Helper
Trigger1 = Time = 0
Persistent = 0
OwnPal = 1
PosType = P1
Pos = 0, 0
StateNo = 30110
Name = " "

;----------エフェクトの大きさ
[State 30100, VarSet] 
Type = VarSet
Trigger1 = Time = 0
FV = 1
Value = 25

[State 30100, VarSet] 
Type = VarSet
Trigger1 = Time > 0
FV = 1
Value = 0.83*FVar(1)

[State 30100, VarSet] 
Type = VarSet
Trigger1 = Time = 0
V = 2
Value = 50

[State 30100, VarAdd] 
Type = VarAdd
Trigger1 = Time > 0
V = 2
Value = Floor(FVar(1))

;----------エフェクトの明るさ
[State 30100, VarSet] 
Type = VarSet
Trigger1 = Time = 0
V = 1
Value = 255

[State 30100, VarAdd] 
Type = VarAdd
Trigger1 = Time > 9
Trigger1 = Var(1) > 0
V = 1
Value = -25

[State 30100, VarSet] 
Type = VarSet
Trigger1 = Var(1) < 0
V = 1
Value = 0

;----------透明化＆大きさ変更
[State 30100, Trans]
Type = Trans
Trigger1 = 1
Trans = Add

[State 30100, PalFX]
Type = PalFX
Trigger1 = 1
Time = 1
Add = 0, 0, 0
Mul = Var(1), Var(1), Var(1)

[State 30100, AngleDraw]
Type = AngleDraw
Trigger1 = 1
Value = 0
Scale = 1.2*Var(2)/122, 0.5*Var(2)/122

;----------消滅条件
[State 30100, DestroySelf]
Type = DestroySelf
Trigger1 = Var(1) = 0

;■■■■■■■■■■■■■■■■■■■■■■■■■
;	[エフェクト]霊撃エフェクト - 拡散
;--------------------------------------------------
;各Animについて
;30110		霊撃エフェクト - 拡散
;
;各Varについて（St30110独自）
