;  Var( 2)	拡大率
;  Var( 3)	拡大率増加分
;
;------------------------------
[StateDef 30110]
Type = A
MoveType = I
Physics = N
Anim = 30110
SprPriority = 100

[State 30110, AssertSpecial]
Type = AssertSpecial
Trigger1 = 1
Flag = NoShadow

;----------エフェクトの大きさ
[State 30110, VarSet] 
Type = VarSet
Trigger1 = animelemtime(1) = 0
V = 3
Value = 100

[State 30110, VarAdd] 
Type = VarAdd
Trigger1 = animelemtime(1) = [2, 6]
V = 3
Value = -10

[State 30110, VarSet] 
Type = VarSet
Trigger1 = animelemtime(1) = 0
V = 2
Value = 460

[State 30110, VarAdd] 
Type = VarAdd
Trigger1 = animelemtime(1) > 0
V = 2
Value = Var(3)

;----------エフェクトの明るさ
[State 30110, VarSet] 
Type = VarSet
Trigger1 = animelemtime(1) = 0
V = 1
Value = 255

[State 30110, VarAdd] 
Type = VarAdd
Trigger1 = animelemtime(1) > 3
Trigger1 = Var(1) > 0
V = 1
Value = -40

[State 30110, VarSet] 
Type = VarSet
Trigger1 = Var(1) < 0
V = 1
Value = 0

;----------透明化＆大きさ変更
[State 30110, Trans]
Type = Trans
Trigger1 = 1
Trans = Add

[State 30110, PalFX]
Type = PalFX
Trigger1 = 1
Time = 1
Add = 0, 0, 0
Mul = Var(1), Var(1), Var(1)

[State 30110, AngleDraw]
Type = AngleDraw
Trigger1 = 1
Value = 0
Scale = 0.5*Var(2)/240, 0.5*Var(2)/240

;----------消滅条件
[State 30110, DestroySelf]
Type = DestroySelf
Trigger1 = Var(1) = 0
