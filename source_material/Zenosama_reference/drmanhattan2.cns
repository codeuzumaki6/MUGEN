;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;------------------
; カウンターの相手側制御開始 - 硬直時間
[Statedef 1992]
type=A
movetype=H
physics=N
velset=0,0
[State 1992, 制御した相手のアニメ変更]
type=ChangeAnim
trigger1=1
value=5000+(selfanimexist(5007)*7)
[State 1992, ステート変更]
type=ChangeState
trigger1=HitShakeOver=1
value=1993
;------------------
; カウンターの相手側制御 - 吹っ飛ぶ
[Statedef 1993]
type     = A
movetype = H
physics  = N
[State 1993, 攻撃を食らった時の移動速度]
type = HitVelSet
trigger1 = Time = 0
x = 1
y = 2
[State 1993, 制御した相手のアニメ変更]
type=ChangeAnim
trigger1=anim!=5001
value=5001
[state ]
type=angledraw
trigger1=1
value=30
[State 1993, 相手すり抜け]
type = PlayerPush
trigger1 = 1
value = 0                ;0にすると他の相手にぶつからない
[State 1993, 速度加算]
type = VelAdd
trigger1 = 1
y = .44
[State 1993, ステート変更] ;壁に当たる時のステートに行く
type = ChangeState
triggerall = Pos Y < -1
trigger1 = BackEdgeBodyDist <= 20
trigger2 = FrontEdgeBodyDist <= 20
value = 1994
[State 1993, 相手ステートに戻す]
type = SelfState
trigger1 = (Vel y > 0) && (Pos y >= 0)
value = 5100

;------------------
; カウンターの相手側制御 - 壁に当たる
[Statedef 1994]
type     = A
movetype = H
physics  = N
[State 1994, 振り返る]
type = Turn
trigger1 = (Time = 0) && (FrontEdgeBodyDist <= 30)
[State 1994, 軸位置移動]
type = PosAdd
trigger1 = Time = 0
x = 15 - BackEdgeBodyDist
y = -10
[State 1994, 移動を止める]
type = PosFreeze
trigger1 = 1
x = 1
y = 1
[State 1994, カメラスクロールの有無]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 0,1
[State 1994, エフェクト表示]
type = Explod
trigger1 = Time = 0
anim = F72
pos = 0, floor(ScreenPos Y) - 50
postype = Back
sprpriority = 3
[State 1994, 振動]
type = EnvShake
trigger1 = Time = 0
time = 5
ampl = 2
[State 1994, 制御した相手のアニメ変更]
type = ChangeAnim2
trigger1 = Time = 0
value = 1027
[State 1994, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 0
value = F7,0
[State 1994, ステート変更]
type = ChangeState
trigger1 = AnimTime>=0
trigger2 = Time>=10
value = 1995
;------------------
; カウンターの相手側制御 - 壁からのバウンド（萃夢想風味）
[Statedef 1995]
type     = A
movetype = H
physics  = N
[State 1995, 軸位置移動]
